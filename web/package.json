{
  "name": "gta-portal-web",
  "version": "1.0.0",
  "description": "GTA Portal frontend \u2014 Vue 3 + Vite",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "axios": "^1.18.1",
    "bootstrap": "^5.3.8",
    "pinia": "^3.0.3",
    "vue": "^3.5.40",
    "vue-router": "^4.5.1"
  },
  "comment:overrides": "Transitive advisories in dev-only test tooling that upstream has not released a fix for yet. All resolve to patched versions with no API change.",
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.0.3",
    "glob": "^13.0.6",
    "js-beautify": "^2.0.3",
    "editorconfig": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.8.0",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.1.1"
  }
}
