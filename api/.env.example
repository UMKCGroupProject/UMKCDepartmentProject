# Copy to .env and adjust. Never commit the real .env.

NODE_ENV=development
PORT=3000

# Origin allowed to call this API. The old server used a wide-open cors().
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=gta
DB_PASSWORD=change-me
DB_NAME=gta_portal

# Must be at least 32 characters. The old code signed tokens with the
# literal string 'TOKEN'.
JWT_SECRET=replace-this-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d
